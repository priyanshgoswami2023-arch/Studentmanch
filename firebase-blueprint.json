{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public-safe student profile without PII.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "stream": { "type": "string", "minLength": 0, "maxLength": 80 },
        "photoUrl": { "type": "string", "minLength": 0, "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII for a student account.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "minLength": 3, "maxLength": 254 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "Quiz": {
      "title": "Quiz",
      "description": "Educational quiz with questions and optional external link.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 2, "maxLength": 200 },
        "titleHi": { "type": "string", "minLength": 0, "maxLength": 200 },
        "category": { "type": "string", "minLength": 2, "maxLength": 60 },
        "durationMinutes": { "type": "number" },
        "externalUrl": { "type": "string", "minLength": 0, "maxLength": 1000 },
        "questions": { "type": "array" },
        "topRankers": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "category", "durationMinutes", "questions", "createdAt", "updatedAt"]
    },
    "QuizAttempt": {
      "title": "QuizAttempt",
      "description": "Saved quiz result for a student.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "quizId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "quizTitle": { "type": "string", "minLength": 1, "maxLength": 200 },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "accuracy": { "type": "number" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "quizId", "quizTitle", "score", "totalQuestions", "accuracy", "completedAt"]
    },
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "Public non-PII ranker entry for a quiz podium.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "quizId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "photoUrl": { "type": "string", "minLength": 0, "maxLength": 2000 },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "quizId", "userId", "name", "score", "totalQuestions", "createdAt"]
    },
    "Notice": {
      "title": "Notice",
      "description": "Important student notice with PDF and external link.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 2, "maxLength": 240 },
        "titleHi": { "type": "string", "minLength": 0, "maxLength": 240 },
        "date": { "type": "string", "minLength": 4, "maxLength": 40 },
        "category": { "type": "string", "minLength": 2, "maxLength": 60 },
        "summary": { "type": "string", "minLength": 10, "maxLength": 2000 },
        "imageUrl": { "type": "string", "minLength": 0, "maxLength": 300000 },
        "pdfUrl": { "type": "string", "minLength": 0, "maxLength": 500000 },
        "externalUrl": { "type": "string", "minLength": 0, "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "date", "category", "summary", "createdAt", "updatedAt"]
    },
    "College": {
      "title": "College",
      "description": "Indian college profile with brochure PDF and link.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 200 },
        "nameHi": { "type": "string", "minLength": 0, "maxLength": 200 },
        "location": { "type": "string", "minLength": 2, "maxLength": 120 },
        "stream": { "type": "string", "minLength": 2, "maxLength": 80 },
        "details": { "type": "string", "minLength": 10, "maxLength": 2500 },
        "detailsHi": { "type": "string", "minLength": 0, "maxLength": 2500 },
        "fees": { "type": "string", "minLength": 0, "maxLength": 120 },
        "examsAccepted": { "type": "string", "minLength": 0, "maxLength": 200 },
        "imageUrl": { "type": "string", "minLength": 0, "maxLength": 300000 },
        "pdfUrl": { "type": "string", "minLength": 0, "maxLength": 500000 },
        "externalUrl": { "type": "string", "minLength": 0, "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "location", "stream", "details", "createdAt", "updatedAt"]
    },
    "NewsArticle": {
      "title": "NewsArticle",
      "description": "Student news article across Exam, Result, Admission, Job, Scholarship.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "slug": { "type": "string", "minLength": 2, "maxLength": 180 },
        "headline": { "type": "string", "minLength": 5, "maxLength": 240 },
        "headlineHi": { "type": "string", "minLength": 0, "maxLength": 240 },
        "category": { "type": "string", "enum": ["Exam", "Result", "Admission", "Job", "Scholarship"] },
        "date": { "type": "string", "minLength": 4, "maxLength": 40 },
        "author": { "type": "string", "minLength": 2, "maxLength": 100 },
        "readTime": { "type": "string", "minLength": 2, "maxLength": 30 },
        "excerpt": { "type": "string", "minLength": 10, "maxLength": 600 },
        "content": { "type": "string", "minLength": 40, "maxLength": 15000 },
        "contentHi": { "type": "string", "minLength": 0, "maxLength": 15000 },
        "imageUrl": { "type": "string", "minLength": 0, "maxLength": 300000 },
        "tags": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "slug", "headline", "category", "date", "author", "readTime", "excerpt", "content", "createdAt", "updatedAt"]
    },
    "Bookmark": {
      "title": "Bookmark",
      "description": "Saved bookmark for an authenticated student.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "itemId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "itemType": { "type": "string", "enum": ["news", "notice", "college", "quiz"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "itemId", "itemType", "title", "createdAt"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Contact Us inquiry submitted by visitors.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "email": { "type": "string", "format": "email", "minLength": 3, "maxLength": 254 },
        "subject": { "type": "string", "minLength": 2, "maxLength": 200 },
        "message": { "type": "string", "minLength": 10, "maxLength": 3000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email", "subject", "message", "createdAt"]
    },
    "AdminWhitelistEntry": {
      "title": "AdminWhitelistEntry",
      "description": "Authorized administrator email whitelist entry stored in Firestore.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "minLength": 3, "maxLength": 120 },
        "role": { "type": "string", "enum": ["owner", "editor"] },
        "active": { "type": "boolean" },
        "addedBy": { "type": "string", "format": "email", "minLength": 3, "maxLength": 254 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "role", "active", "addedBy", "createdAt", "updatedAt"]
    },
    "CatalogTombstone": {
      "title": "CatalogTombstone",
      "description": "Tracks deleted built-in catalog items so deletions sync across all devices.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "kind": { "type": "string", "enum": ["quiz", "notice", "college", "news"] },
        "deletedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "kind", "deletedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Public-safe student profile documents."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Owner-only PII documents for student accounts."
    },
    "/quizzes/{quizId}": {
      "schema": { "$ref": "#/entities/Quiz" },
      "description": "Public educational quizzes managed by admins."
    },
    "/quiz_attempts/{attemptId}": {
      "schema": { "$ref": "#/entities/QuizAttempt" },
      "description": "Authenticated student quiz attempts and progress."
    },
    "/leaderboards/{entryId}": {
      "schema": { "$ref": "#/entities/LeaderboardEntry" },
      "description": "Public leaderboard podium entries for quizzes."
    },
    "/notices/{noticeId}": {
      "schema": { "$ref": "#/entities/Notice" },
      "description": "Important notices with PDF and official links."
    },
    "/colleges/{collegeId}": {
      "schema": { "$ref": "#/entities/College" },
      "description": "Indian college listings with brochures and links."
    },
    "/news/{newsId}": {
      "schema": { "$ref": "#/entities/NewsArticle" },
      "description": "Original bilingual student news articles."
    },
    "/bookmarks/{bookmarkId}": {
      "schema": { "$ref": "#/entities/Bookmark" },
      "description": "Student saved bookmarks."
    },
    "/contact_messages/{messageId}": {
      "schema": { "$ref": "#/entities/ContactMessage" },
      "description": "Contact form messages readable only by admins."
    },
    "/admin_whitelist/{entryId}": {
      "schema": { "$ref": "#/entities/AdminWhitelistEntry" },
      "description": "Firestore whitelist of verified administrator emails allowed to access AdminPage."
    },
    "/catalog_tombstones/{itemId}": {
      "schema": { "$ref": "#/entities/CatalogTombstone" },
      "description": "Deleted seed catalog item markers readable publicly and writable only by admins."
    }
  }
}
